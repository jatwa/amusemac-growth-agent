# Amusemac Growth Agent - Server Environment Variables

# Server Port
PORT=3001

# Admin Credential Configuration
ADMIN_EMAIL=admin@amusemacstudio.in
ADMIN_PASSWORD=your_admin_password_here

# Real Public Web Search Provider Configuration
# Supported providers: 'serpapi' | 'google_custom_search'
WEB_SEARCH_PROVIDER=serpapi
WEB_SEARCH_API_KEY=your_serpapi_api_key_here

# Alternative Search Provider Key Alias
SERPAPI_API_KEY=your_serpapi_api_key_here

# Zoho Mail Enterprise Configuration (Optional)
ZOHO_EMAIL=hello@amusemacstudio.in
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=hello@amusemacstudio.in
ZOHO_SMTP_PASSWORD=your_zoho_smtp_password
ZOHO_IMAP_HOST=imappro.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_IMAP_USER=hello@amusemacstudio.in
ZOHO_IMAP_PASSWORD=your_zoho_imap_password
